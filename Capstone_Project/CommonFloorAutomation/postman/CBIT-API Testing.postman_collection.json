        {
          "name": "AutomationExercise - GET Request - BrandsList",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response time < 3000ms', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test('Response body is not empty', function () { pm.expect(pm.response.text()).to.not.be.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://automationexercise.com/api/brandsList",
              "protocol": "https",
              "host": ["automationexercise", "com"],
              "path": ["api", "brandsList"]
            }
          }
        },
